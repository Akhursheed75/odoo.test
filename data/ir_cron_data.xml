<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        NOTE: Odoo 18+ dropped `numbercall`/`doall` from ir.cron — this
        record deliberately omits them. If you're on Odoo <= 17, add
        <field name="numbercall">-1</field> back in.
    -->
    <record id="ir_cron_o2c_overdue_tiers" model="ir.cron">
        <field name="name">O2C: Recompute Overdue Tiers &amp; Create Reminders</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model.o2c_cron_recompute_overdue_tiers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_o2c_payment_matching" model="ir.cron">
        <field name="name">O2C: Auto-Match Unreconciled Customer Payments</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="state">code</field>
        <field name="code">model.o2c_cron_auto_match_payments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
