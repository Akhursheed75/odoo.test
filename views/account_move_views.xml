<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Anchored on `invoice_date_due`, a standard field on the invoice
        form. If inherit_id below doesn't match your instance, open an
        Invoice in Developer Mode (bug icon > Edit View: Form) to find the
        correct view id.
    -->
    <record id="view_move_form_o2c_inherit" model="ir.ui.view">
        <field name="name">account.move.form.o2c.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="x_overdue_tier" invisible="move_type != 'out_invoice'"
                       widget="badge"
                       decoration-success="x_overdue_tier in ('not_due', 'paid')"
                       decoration-warning="x_overdue_tier in ('due_soon', 'due_today')"
                       decoration-danger="x_overdue_tier in ('overdue_1_7', 'overdue_8_15', 'overdue_15_plus')"/>
            </field>
        </field>
    </record>
</odoo>
