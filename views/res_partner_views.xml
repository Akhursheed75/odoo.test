<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Anchored on the standard `phone` field, present on every contact form. -->
    <record id="view_partner_form_o2c_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.o2c.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field name="x_customer_type"/>
            </field>
        </field>
    </record>
</odoo>
